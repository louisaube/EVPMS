DATABASE_URL=postgres://database:database@localhost:5432/evpms
JWT_SECRET=change-me
COOKIE_SECRET=change-me
PORT=4000
STUDIO_ORIGINS=http://localhost:5173
# Optional EVP settings (names only, never a value: the secrets live in the environment of the machine)
# EVP_SOURCES_DRIVER=            real | fake (fake: fixtures of the tests, outside production only; production is always real)
# EVP_STORAGE_DRIVER=fake
# EVP_MAINTENANCE=false
# Google sign-in (OpenID Connect): without GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GOOGLE_PUBLIC_ORIGIN (or
# GOOGLE_REDIRECT_URI) the service answers unavailable / google_not_configured
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PUBLIC_ORIGIN=          public origin of the API; the return address is <origin>/google-sign-in/callback
# GOOGLE_REDIRECT_URI=           overrides the return address when present
# GOOGLE_ALLOWED_DOMAIN=         default micro-stars.fr
# GOOGLE_AUTH_URL=               default https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=              default https://oauth2.googleapis.com/token
# GOOGLE_CERTS_URL=              default https://www.googleapis.com/oauth2/v3/certs
# Google Sheets (table of the crèches, read only, service account)
# SHEETS_BASE_URL=               default https://sheets.googleapis.com
# SHEETS_SPREADSHEET_ID=
# SHEETS_TAB_NAME=               default Contacts des crèches
# SHEETS_RANGE=                  default A:G
# SHEETS_CLIENT_EMAIL=
# SHEETS_PRIVATE_KEY=            secret, PEM with the line breaks written \n
# SHEETS_TOKEN_URL=              default: the value of GOOGLE_TOKEN_URL
# PayFit (partner API, read only)
# PAYFIT_BASE_URL=               default https://partner-api.payfit.com
# PAYFIT_INTROSPECT_URL=         default https://oauth.payfit.com/introspect
# PAYFIT_API_KEYS=               secret, JSON list of { siret, apiKey }, one entry per SIRET
# PAYFIT_ABSENCE_TYPES_FILE=     default config/payfit-absence-types.json
# PAYFIT_RETRY_DELAY_MS=         default 1000 (base wait before a new try on 429 or 5xx, doubled at each try)
# SOURCES_RETRY_DELAY_MS=        same for Sheets and Aqoona; default PAYFIT_RETRY_DELAY_MS
# Aqoona (tokenised addresses, JSON)
# AQOONA_URLS=                   secret, JSON list of { label (optional), url }
# AQOONA_MAPPING_FILE=           default config/aqoona-mapping.json
# EVP_S3_ENDPOINT=
# EVP_S3_REGION=eu-west-3
# EVP_S3_BUCKET=
# EVP_S3_ACCESS_KEY_ID=
# EVP_S3_SECRET_ACCESS_KEY=
